local INVITE = "hollyscriptx-1504482964661076098"
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local requestFn =
	(typeof(syn) == "table" and syn.request)
	or (typeof(http) == "table" and http.request)
	or http_request
	or (typeof(fluxus) == "table" and fluxus.request)
	or request

local function copy(text)
	if setclipboard then
		setclipboard(text)
	elseif toclipboard then
		toclipboard(text)
	elseif syn and syn.write_clipboard then
		syn.write_clipboard(text)
	end
end

local function notify(title, text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 5,
		})
	end)
end

local function kick(reason)
	pcall(function()
		Players.LocalPlayer:Kick(reason)
	end)
end

local function openDiscord()
	if not requestFn then
		copy("https://discord.gg/" .. INVITE)
		notify("Discord", "Link copied (request unavailable)")
		kick("Discord invite copied")
		return false
	end

	local ok = pcall(function()
		requestFn({
			Url = "http://127.0.0.1:6463/rpc?v=1",
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Origin"] = "https://discord.com",
			},
			Body = HttpService:JSONEncode({
				cmd = "INVITE_BROWSER",
				args = {
					code = INVITE,
				},
				nonce = HttpService:GenerateGUID(false),
			}),
			Options = {
				Keepalive = false,
			},
		})
	end)

	if ok then
		notify("Discord", "Invite opened! Check Discord.")
		kick("Discord invite opened")
		return true
	else
		copy("https://discord.gg/" .. INVITE)
		notify("Discord not running", "Link copied to clipboard")
		kick("Discord invite copied")
		return false
	end
end

openDiscord()
